{
  "name": "sigil-synth",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run build.ts --dev --watch --serve",
    "clean": "rm -rf dist",
    "serve": "cd dist && bunx serve",
    "test": "bun test tests/unit && bunx playwright test",
    "test:unit": "bun test tests/unit",
    "test:e2e": "bunx playwright test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "lefthook": "^2.1.1",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0"
  }
}
