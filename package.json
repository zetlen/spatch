{
  "name": "spatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run build.ts --dev --watch --serve",
    "clean": "rm -rf dist",
    "serve": "cd dist && bunx serve",
    "test": "bun test && bunx playwright test",
    "test:unit": "bun test",
    "test:e2e": "bunx playwright test",
    "check": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tabler/icons": "3.38.0",
    "lefthook": "^2.1.1",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
